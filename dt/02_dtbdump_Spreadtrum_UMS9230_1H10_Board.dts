			fingerprint@0 {
				compatible = "microarray,afs121";
				fpint-gpios = <&eic_async>, <0x1d 0x00>;
			};

			gpio-keys {
				compatible = "gpio-keys";

				key-volumedown {
					label = "Volume Down Key";
					linux,code = <0x72>;
					gpios = <&ap_gpio>, <0x7c 0x01>;
					debounce-interval = <0x02>;
					wakeup-source;
				};

				key-volumeup {
					label = "Volume Up Key";
					linux,code = <0x73>;
					gpios = <&ap_gpio>, <0x7d 0x01>;
					debounce-interval = <0x02>;
					wakeup-source;
				};

				key-power {
					label = "Power Key";
					linux,code = <0x74>;
					gpios = <&pmic_eic>, <0x01 0x01>;
					debounce-interval = <0x02>;
					wakeup-source;
				};
			};

			bat: battery {
