	fragment@10 {
		target = <&dvfs_dcdc_cpu1_cfg>;

		__overlay__ {
			chnl-i2c-used;
			third-pmic-used;
			pmic-type-num = <0x02>;
			slew-rate = <0xfa0>;
			tuning-latency-us = <0x00>;
		};
