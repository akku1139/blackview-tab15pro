			#size-cells = <0x00>;

			himax_ts@48 {
				status = "disabled";
				compatible = "himax,hxcommon";
				reg = <0x48>;
				himax,panel-coords = <0x00 0x4b0 0x00 0x780>;
				himax,display-coords = <0x00 0x4b0 0x00 0x780>;
