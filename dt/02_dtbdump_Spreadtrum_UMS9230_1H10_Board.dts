				fchg-jeita-temp-table = <0x3e8 0x406 0x00 0x43bfc0 0x47e 0x49c 0x319750 0x43bfc0 0x5c8 0x5aa 0x319750 0x43bfc0 0x622 0x604 0x200b20 0x43bfc0>;
				flash-jeita-temp-table = <0x3e8 0x3fc 0x00 0x43bfc0 0x41a 0x42e 0x7a120 0x43bfc0 0x460 0x474 0xf4240 0x43bfc0 0x488 0x49c 0x1e8480 0x43bfc0 0x4c4 0x4d8 0x44aa20 0x43bfc0 0x53c 0x550 0x4c4b40 0x43bfc0 0x55a 0x546 0x4c4b40 0x43bfc0 0x578 0x564 0x44aa20 0x43bfc0 0x58c 0x578 0x40d990 0x43bfc0 0x5aa 0x596 0x3d0900 0x43bfc0 0x622 0x604 0xf4240 0x43bfc0>;
				wl-bpp-jeita-temp-table = <0x3e8 0x406 0x00 0x43bfc0 0x47e 0x49c 0x7a120 0x43bfc0 0x5c8 0x5aa 0xf4240 0x43bfc0 0x622 0x604 0x4c4b40 0x43bfc0>;
				wl-epp-jeita-temp-table = <0x3e8 0x406 0x00 0x43bfc0 0x47e 0x49c 0x1e8480 0x43bfc0 0x5c8 0x5aa 0x1e8480 0x43bfc0 0x622 0x604 0x1e8480 0x43bfc0>;
