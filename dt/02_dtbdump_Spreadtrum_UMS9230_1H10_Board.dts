			charger-manager {
				compatible = "charger-manager";
				cm-name = "battery";
				cm-poll-mode = <0x02>;
				cm-poll-interval = <0x3a98>;
				cm-battery-stat = <0x02>;
				cm-fullbatt-vchkdrop-ms = <0x7530>;
				cm-fullbatt-vchkdrop-volt = <0xea60>;
				cm-fullbatt-capacity = <0x64>;
				cm-cp-taper-current = <0xf4240>;
				cm-num-chargers = <0x02>;
				cm-num-fast-chargers = <0x01>;
				cm-num-wireless-chargers = <0x01>;
				cm-num-wireless-charge-pump-converters = <0x01>;
				cm-chargers = "bq2560x_charger", "bq2560x_slave_charger";
				cm-fast-chargers = "sc2730_fast_charger";
				cm-fuel-gauge = "sc27xx-fgu";
				cm-battery-cold = <0xc8>;
				cm-battery-cold-in-minus;
				cm-battery-hot = <0x320>;
				cm-battery-temp-diff = <0x64>;
				cm-charging-max = <0x1499700>;
				cm-discharging-max = <0x2932e0>;
				cm-wdt-interval = <0x3c>;
				cm-shutdown-voltage = <0x2f4d60>;
				cm-tickle-time-out = <0x190>;
				cm-one-cap-time = <0x3c>;
				cm-charge-voltage-max = <0x632ea0>;
				cm-fast-charge-voltage-max = <0xa037a0>;
				cm-flash-charge-voltage-max = <0xb71b00>;
				cm-wireless-charge-voltage-max = <0x632ea0>;
				cm-wireless-fast-charge-voltage-max = <0xb71b00>;
				cm-charge-voltage-drop = <0xaae60>;
				cm-fast-charge-voltage-drop = <0xaae60>;
				cm-flash-charge-voltage-drop = <0xf4240>;
				cm-cap-remap-table = <0x01 0x02 0x02 0x03 0x06 0x01 0x62 0x63 0x02 0x63 0x64 0x02>;
				monitored-battery = <&bat>;

				regulator@0 {
					cm-regulator-name = "vddgen0";

					cable@0 {
						cm-cable-name = "USB";
						extcon = <&pmic_typec>;
					};
				};
			};

			tboard_thermistor: thermal-sensor {
				compatible = "generic-adc-thermal";
				#thermal-sensor-cells = <0x00>;
				io-channels = <&pmic_adc>, <0x01>;
				io-channel-names = "sensor-channel";
				temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
				phandle = <0x06>;
			};

			pa_thermistor: pa-sensor {
				compatible = "generic-adc-thermal";
				#thermal-sensor-cells = <0x00>;
				io-channels = <&pmic_adc>, <0x02>;
				io-channel-names = "sensor-channel";
				temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
				phandle = <0x07>;
			};

			chg_thermistor: chg-sensor {
				compatible = "generic-adc-thermal";
				#thermal-sensor-cells = <0x00>;
				io-channels = <&pmic_adc>, <0x04>;
				io-channel-names = "sensor-channel";
				temperature-lookup-table = <0xffff64c2 0x46b 0xffff8baf 0x456 0xffffb3e8 0x432 0xffffedb9 0x3d7 0x277e 0x346 0x60e5 0x28e 0xaf7a 0x19d 0xd677 0x13c 0xfd7f 0xee 0x12484 0xb2 0x14b93 0x85 0x172a3 0x64 0x199b0 0x4b 0x1c0c9 0x39 0x1e7c8 0x2b>;
				phandle = <0x08>;
			};

			audio-voice-trig {
				status = "disable";
				compatible = "sprd,voice_trig";
				irq_gpio = <&ap_gpio>, <0xa9 0x00>;
			};

			sprd_uid {
				compatible = "sprd-uid";
				nvmem-cells = <&uid_start>, <&uid_end>;
				nvmem-cell-names = "uid_start", "uid_end";
			};
		};
	};

	fragment@0 {
		target = <&sipc>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sipc_wcn: core@3 {
				compatible = "sprd,sipc";
				reg = <0x03>;
				label = "sipc-wcn";
				mboxes = <&mailbox>, <0x08 0x00>;
				sprd,smem-info = <0x87240000 0x240000 0x140000>;
				phandle = <0x1b>;

				wcn_bt {
					compatible = "sprd,wcn_internal_chip";
					sprd,name = "ttyBT";
					sprd,dst = <0x03>;
					sprd,channel = <0x04>;
					sprd,tx_bufid = <0x0b>;
					sprd,rx_bufid = <0x0a>;
				};

				wcn_fm {
					compatible = "sprd,wcn_fm_internal_chip";
					sprd,name = "fm";
					sprd,dst = <0x03>;
					sprd,tx_channel = <0x04>;
					sprd,rx_channel = <0x04>;
					sprd,tx_bufid = <0x0e>;
					sprd,rx_bufid = <0x0d>;
				};
			};

			sipc_gnss: core@4 {
				compatible = "sprd,sipc";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x04>;
				label = "sipc-gnss";
				mboxes = <&mailbox>, <0x09 0x00>;
				sprd,smem-info = <0x8749b000 0x11b000 0x32000>;
				phandle = <0x1c>;

				sttygnss0: channel@4 {
					compatible = "sprd,spipe";
					reg = <0x04>;
					label = "sttygnss0";
					sprd,ringnr = <0x01>;
					sprd,size-rxbuf = <0x19000>;
					sprd,size-txbuf = <0xc800>;
					phandle = <0x1d>;
				};
			};
		};
	};

	fragment@1 {
		target = <&chosen>;

		__overlay__ {
			bootargs_ext = "androidboot.hardware=ums9230_1h10 androidboot.dtbo_idx=0";
		};
	};

	fragment@2 {
		target = <&reserved_memory>;

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x02>;

			wcn_reserved: wcn-mem@87000000 {
				reg = <0x00 0x87000000 0x00 0x800000>;
				phandle = <0x1e>;
			};

			logo_reserved: logobuffer@9e000000 {
				reg = <0x00 0x9e000000 0x00 0xab0000>;
				phandle = <0x0b>;
			};

			widevine_reserved: widevine@e3800000 {
				reg = <0x00 0xe3800000 0x00 0xc800000>;
				phandle = <0x13>;
			};

			fd_reserved: faceid-mem@ffa70000 {
				reg = <0x00 0xffa70000 0x00 0x500000>;
				phandle = <0x14>;
			};
		};
	};

	fragment@3 {
		target = <&thm_zone>;

		__overlay__ {

			bd_thmzone: board-thmzone {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&tboard_thermistor>;
				phandle = <0x1f>;
			};

			pa_thmzone: pa-thmzone {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&pa_thermistor>;
				phandle = <0x20>;
			};

			chg_thmzone: chg-thmzone {
				polling-delay-passive = <0x00>;
				polling-delay = <0x00>;
				thermal-sensors = <&chg_thermistor>;
				phandle = <0x21>;
			};
		};
	};

	fragment@4 {
		target = <&i2c0>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sensor_main: sensor-main@20 {
				compatible = "sprd,sensor-main";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk>, <0x02>, <&mm_gate>, <0x0d>, <&pll1>, <0x04>, <&pll1>, <0x10>, <&pll1>, <0x05>, <&ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				reset-gpios = <&ap_gpio>, <0x2c 0x00>;
				power-down-gpios = <&ap_gpio>, <0x2e 0x00>;
				sprd,phyid = <0x00>;
				csi = <&csi0>;
				power-domains = <&mm_domain>;
				phandle = <0x22>;
			};

			sensor_sub: sensor-sub@21 {
				compatible = "sprd,sensor-sub";
				reg = <0x21>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk>, <0x04>, <&mm_gate>, <0x0b>, <&pll1>, <0x04>, <&pll1>, <0x10>, <&pll1>, <0x05>, <&ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama0>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				reset-gpios = <&ap_gpio>, <0x29 0x00>;
				power-down-gpios = <&ap_gpio>, <0x28 0x00>;
				sprd,phyid = <0x02>;
				csi = <&csi0>;
				power-domains = <&mm_domain>;
				phandle = <0x23>;
			};
		};
	};

	fragment@5 {
		target = <&i2c1>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sensor_main2: sensor-main2@20 {
				compatible = "sprd,sensor-main2";
				reg = <0x20>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk>, <0x03>, <&mm_gate>, <0x0c>, <&pll1>, <0x04>, <&pll1>, <0x10>, <&pll1>, <0x05>, <&ext_26m>;
				vddio-supply = <&vddcamio>;
				vddcama-supply = <&vddcama1>;
				vddcamd-supply = <&vddcamd0>;
				vddcammot-supply = <&vddcammot>;
				avdd-gpios = <&ap_gpio>, <0x21 0x00>;
				mot-gpios = <&ap_gpio>, <0x58 0x00>;
				reset-gpios = <&ap_gpio>, <0x2d 0x00>;
				power-down-gpios = <&ap_gpio>, <0x2f 0x00>;
				sprd,phyid = <0x03>;
				csi = <&csi1>;
				power-domains = <&mm_domain>;
				phandle = <0x24>;
			};
		};
	};

	fragment@6 {
		target = <&i2c5>;

		__overlay__ {
			status = "okay";
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			bq2560x_chg: charger@6b {
				compatible = "ti,bq2560x_chg";
				reg = <0x6b>;
				phys = <&hsphy>;
				monitored-battery = <&bat>;
				extcon = <&pmic_typec>, <&pmic_pd>;
				pd-extcon-enable;
				phandle = <0x25>;

				vddvbus: otg-vbus {
					regulator-name = "vddvbus";
					phandle = <0x09>;
				};
			};

			flash_ic: flash-ic@63 {
				compatible = "sprd,flash-ocp8137";
				reg = <0x63>;
				sprd,flash-ic = <0x1fc9>;
				sprd,torch = <0x01>;
				sprd,preflash = <0x01>;
				sprd,highlight = <0x01>;
				sprd,torch-level = <0x80>;
				sprd,preflash-level = <0x80>;
				sprd,highlight-level = <0x80>;
				sprd,lvfm-enable = <0x01>;
				flash-torch-en-gpios = <&ap_gpio>, <0x20 0x00>;
				flash-chip-en-gpios = <&ap_gpio>, <0x8a 0x00>;
				flash-en-gpios = <&ap_gpio>, <0x8b 0x00>;
				phandle = <0x26>;
			};
		};
	};

	fragment@7 {
		target = <&i2c6>;

		__overlay__ {
			status = "disabled";
			clock-frequency = <0x61a80>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sensor_sub2: sensor-sub2@6e {
				compatible = "sprd,sensor-sub2";
				reg = <0x6e>;
				clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
				clocks = <&mm_clk>, <0x04>, <&mm_gate>, <0x0b>, <&pll1>, <0x04>, <&pll1>, <0x10>, <&pll1>, <0x05>, <&ext_26m>;
				vddio-supply = <&vddcamio>;
				avdd-gpios = <&ap_gpio>, <0x82 0x00>;
				vddcamd-supply = <&vddcamd1>;
				vddcammot-supply = <&vddcammot>;
				mot-gpios = <&ap_gpio>, <0x70 0x00>;
				reset-gpios = <&ap_gpio>, <0x72 0x00>;
				sprd,phyid = <0x03>;
				csi = <&csi2>;
				phandle = <0x27>;
			};
		};
	};

	fragment@8 {
		target = <&spi3>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			focaltech_ts_spi@0 {
				reg = <0x00>;
				status = "okay";
				spi-max-frequency = <0x927c00>;
				compatible = "focaltech,focaltech_ts_spi";
				focaltech,reset-gpio = <&ap_gpio>, <0x91 0x00>;
				focaltech,irq-gpio = <&ap_gpio>, <0x90 0x00>;
				vdd_name = "vdd28";
				focaltech,display-coords = <0x00 0x00 0x4af 0x77f>;
				virtualkeys = <0x50 0x384 0x1e 0x1e 0xf0 0x384 0x1e 0x1e 0x190 0x384 0x1e 0x1e>;
				TP_MAX_X = <0x4b0>;
				TP_MAX_Y = <0x780>;
			};

			himax_ts@1 {
				status = "okay";
				compatible = "himax,hxcommon";
				reg = <0x01>;
				spi-max-frequency = <0x989680>;
				spi-cpha;
				himax,panel-coords = <0x00 0x4b0 0x00 0x780>;
				himax,display-coords = <0x00 0x4b0 0x00 0x780>;
				himax,irq-gpio = <&ap_gpio>, <0x90 0x00>;
				himax,rst-gpio = <&ap_gpio>, <0x91 0x00>;
				report_type = <0x01>;
			};
		};
	};

	fragment@9 {
		target = <&dvfs_dcdc_cpu0_cfg>;

		__overlay__ {
			pmic-type-num = <0x00>;
			slew-rate = <0x249f>;
			tuning-latency-us = <0x00>;
		};
