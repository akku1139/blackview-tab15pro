	fragment@12 {
		target = <&usb>;

		__overlay__ {
			extcon = <&extcon_gpio>, <&pmic_typec>;
			vbus-supply = <&vddvbus>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <&sdio0>;

		__overlay__ {
			cd-gpios = <&eic_sync>, <0x23 0x00>;
		};
	};

	fragment@14 {
		target = <&i2c2>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			sec-nfc@27 {
				compatible = "sec-nfc";
				reg = <0x27>;
				clock-names = "nfc_clk", "source", "enable";
				clocks = <&aon_clk>, <0x04>, <&ext_26m>, <&aonapb_gate>, <0x06>;
				sec-nfc,ven-gpio = <&ap_gpio>, <0x3f 0x00>;
				sec-nfc,firm-gpio = <&ap_gpio>, <0x3d 0x00>;
				sec-nfc,irq-gpio = <&ap_gpio>, <0x3e 0x00>;
				sec-nfc,clk-req = <&ap_gpio>, <0x3c 0x00>;
