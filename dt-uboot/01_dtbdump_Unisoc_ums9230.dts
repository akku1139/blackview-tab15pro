/dts-v1/;

/ {
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	cpuinfo_hardware = "Unisoc ums9230";
	model = "Spreadtrum ums9230_1h10 Board";
	compatible = "sprd,ums9230_1h10";
	sprd,sc-id = "ums9230 1h10 1000";

	aliases {
		i2c0 = "/soc/ap-apb/i2c@0x200d0000";
		i2c1 = "/soc/ap-apb/i2c@0x200e0000";
		i2c2 = "/soc/ap-apb/i2c@0x200f0000";
		i2c3 = "/soc/ap-apb/i2c@0x20100000";
		i2c4 = "/soc/ap-apb/i2c@0x20110000";
		i2c5 = "/soc/ap-apb/i2c@0x20210000";
		i2c6 = "/soc/ap-apb/i2c@0x20220000";
		spi4 = "/soc/aon/spi@64200000";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		syscon@64000000 {
			compatible = "syscon";
			reg = <0x00 0x64000000 0x00 0x3000>;
		};

		syscon@64020000 {
			compatible = "syscon";
			reg = <0x00 0x64020000 0x00 0x3000>;
		};

		aon {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			spi@64200000 {
				compatible = "sprd,qogirl6-adi", "sprd,sharkl5pro-adi";
				reg = <0x00 0x64200000 0x00 0x100000>;
				sprd,hw-channels = <0x15 0x1864>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};
		};

		ap-apb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			i2c@0x200d0000 {
				compatible = "sprd,qogirl6-i2c";
				reg = <0x00 0x200d0000 0x00 0x100>;
				clock-frequency = <0x61a80>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x01 0x09 0x02 0x04 0x03>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};

			i2c@0x200e0000 {
				compatible = "sprd,qogirl6-i2c";
				reg = <0x00 0x200e0000 0x00 0x100>;
				clock-frequency = <0x61a80>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x01 0x0a 0x02 0x05 0x03>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};

			i2c@0x200f0000 {
				compatible = "sprd,qogirl6-i2c";
				reg = <0x00 0x200f0000 0x00 0x100>;
				clock-frequency = <0x61a80>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x01 0x0b 0x02 0x06 0x03>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};

			i2c@0x20100000 {
				compatible = "sprd,qogirl6-i2c";
				reg = <0x00 0x20100000 0x00 0x100>;
				clock-frequency = <0x61a80>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x01 0x0c 0x02 0x07 0x03>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};

			i2c@0x20110000 {
				compatible = "sprd,qogirl6-i2c";
				reg = <0x00 0x20110000 0x00 0x100>;
				clock-frequency = <0x61a80>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x01 0x0d 0x02 0x08 0x03>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
			};

			i2c@0x20210000 {
				compatible = "sprd,qogirl6-i2c";
				reg = <0x00 0x20210000 0x00 0x100>;
				clock-frequency = <0x61a80>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x01 0x1a 0x02 0x09 0x03>;
