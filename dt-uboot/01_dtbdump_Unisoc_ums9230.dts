		lcd_dummy_mipi_hd {
			sprd,dsi-work-mode = <0x01>;
			sprd,dsi-lane-number = <0x04>;
			sprd,dsi-color-format = "rgb888";
			sprd,phy-bit-clock = <0x7a120>;
			sprd,panel-if-type = <0x02>;
			sprd,lcd-id-tokernel = <0xffff>;
			sprd,initial-command = [13 78 00 01 11 13 64 00 01 29];
			sprd,sleep-in-command = [13 0a 00 01 28 13 78 00 01 10];
			sprd,sleep-out-command = [13 78 00 01 11 13 64 00 01 29];

			display-timings {

				timing0 {
					clock-frequency = <0x493e000>;
					hactive = <0x2d0>;
					vactive = <0x500>;
					hback-porch = <0x3c>;
					hfront-porch = <0x50>;
					vback-porch = <0x0c>;
					vfront-porch = <0x26>;
					hsync-len = <0x3c>;
					vsync-len = <0x04>;
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		fastbootbuffer@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x40000000>;
			linux,phandle = <0x09>;
			phandle = <0x09>;
		};

		sparsebuffer@c0000000 {
			reg = <0x00 0xc0000000 0x00 0x40000000>;
			linux,phandle = <0x0a>;
			phandle = <0x0a>;
		};

		alterbuffer1@92000000 {
			reg = <0x00 0x92000000 0x00 0x200000>;
			linux,phandle = <0x0b>;
			phandle = <0x0b>;
		};

		alterbuffer2@92200000 {
			reg = <0x00 0x92200000 0x00 0x200000>;
			linux,phandle = <0x0c>;
			phandle = <0x0c>;
		};

		pre_log_buffer@92300000 {
			reg = <0x00 0x92300000 0x00 0x2000>;
		};

		logbuffer@9de80000 {
			reg = <0x00 0x9de80000 0x00 0x80000>;
			linux,phandle = <0x0d>;
			phandle = <0x0d>;
		};

		secboot-arg-mem@98100000 {
			reg = <0x00 0x98100000 0x00 0xf00000>;
		};

		secboot-vbmeta-mem@99000000 {
			reg = <0x00 0x99000000 0x00 0x800000>;
		};

		secboot-verify-mem@99800000 {
			reg = <0x00 0x99800000 0x00 0x3000000>;
		};

		bmp-mem@9d000000 {
			reg = <0x00 0x9d000000 0x00 0xab0000>;
			linux,phandle = <0x0e>;
			phandle = <0x0e>;
		};

		logobuffer@9e000000 {
			reg = <0x00 0x9e000000 0x00 0xab0000>;
			linux,phandle = <0x08>;
			phandle = <0x08>;
		};

		sml-mem@b0000000 {
			reg = <0x00 0xb0000000 0x00 0x20000>;
		};

		tos-mem@b0020000 {
			reg = <0x00 0xb0020000 0x00 0x5fe0000>;
		};
	};

	ion {
		compatible = "sprd,ion";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		heap@3 {
			reg = <0x03>;
			label = "carveout_logo";
			type = <0x02>;
			memory-region = <0x08>;
		};

		heap@4 {
			reg = <0x04>;
			label = "carveout_fastboot";
			type = <0x02>;
			memory-region = <0x09>;
		};

		heap@5 {
			reg = <0x05>;
			label = "carveout_download";
			type = <0x02>;
			memory-region = <0x0a>;
		};

		heap@6 {
			reg = <0x06>;
			label = "carveout_dl_alt1";
			type = <0x02>;
			memory-region = <0x0b>;
		};

		heap@7 {
			reg = <0x07>;
			label = "carveout_dl_alt2";
			type = <0x02>;
			memory-region = <0x0c>;
		};

		heap@8 {
			reg = <0x08>;
			label = "carveout_log";
			type = <0x02>;
			memory-region = <0x0d>;
		};

		heap@9 {
			reg = <0x09>;
			label = "carveout_bmp";
			type = <0x02>;
			memory-region = <0x0e>;
		};
	};

	sprd-sensorhub {
		compatible = "sprd-sensorhub-uboot";
	};

	lcd-panel {
		compatible = "sprd,generic-mipi-panel";
		sprd,lcd-avdd-gpio = <0x87>;
		sprd,lcd-avee-gpio = <0x88>;
		sprd,lcd-reset-gpio = <0x32>;
		sprd,lcd-backlight-gpio = <0x4d>;
	};

	bq2560x-charger {
		compatible = "sprd,bq2560x-charger";
		sprd,bq2560x-i2c-bus = <0x05>;
	};

	lcd-i2c-power {
		compatible = "sprd,lcd-i2c";
		sprd,lcd-i2c-bus = <0x05>;
	};
};
