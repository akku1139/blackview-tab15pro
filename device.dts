				syscon-names = "i2c_rst";
				syscons = <0x02 0x04 0x400>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x04 0x0b 0x05 0x06 0x03>;
				phandle = <0xef>;

				sec-nfc@27 {
					sec-nfc,clk-req = <0x46 0x3c 0x00>;
					sec-nfc,irq-gpio = <0x46 0x3e 0x00>;
