					mot-gpios = <0x46 0x58 0x00>;
					avdd-gpios = <0x46 0x21 0x00>;
					vddcammot-supply = <0x13c>;
					vddcamd-supply = <0x137>;
					vddcama-supply = <0x13b>;
					vddio-supply = <0x6d>;
					clocks = <0x10 0x03 0x0f 0x0c 0x06 0x04 0x06 0x10 0x06 0x05 0x03>;
					clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
					reg = <0x20>;
					compatible = "sprd,sensor-main2";
				};
			};

			i2c2: i2c@0x200f0000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x200f0000 0x00 0x100>;
				interrupts = <0x00 0x0d 0x04>;
