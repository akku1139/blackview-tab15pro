			};

			jpg_qos: qos@4 {
				reg = <0x04>;
				arqos-high = [07];
				arqos-low = [01];
				awqos = [01];
				phandle = <0xe2>;
			};

			mm_qos_threshold: qos@5 {
				reg = <0x05>;
				arqos-threshold = [06];
				awqos-threshold = [06];
				phandle = <0x11>;
			};
		};

		ap {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			ap_qos0: qos@0 {
				reg = <0x00>;
				arqos-ce = [05];
				awqos-ce = [05];
				arqos-dma = [05];
				awqos-dma = [05];
				phandle = <0xe3>;
			};

			ap_qos1: qos@1 {
				reg = <0x01>;
				arqos-sdio0 = [05];
				awqos-sdio0 = [05];
				arqos-sdio1 = [05];
				awqos-sdio1 = [05];
				arqos-sdio2 = [05];
				awqos-sdio2 = [05];
				arqos-emmc = [05];
				awqos-emmc = [05];
				phandle = <0xe4>;
			};

			ap_qos_threshold: qos@2 {
				reg = <0x02>;
				arqos-threshold-main = [05];
				awqos-threshold-main = [05];
				arqos-threshold-merge = [06];
				awqos-threshold-merge = [06];
				phandle = <0xe5>;
			};
		};

		wcn {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			wcn_qos0: qos@0 {
				reg = <0x00>;
				arqos-wifi = [0c];
				awqos-wifi = [0c];
				arqos-btwifi-i = [09];
				awqos-btwifi-i = [09];
				arqos-btwifi-d = [09];
				awqos-btwifi-d = [09];
				arqos-dma = [09];
				awqos-dma = [09];
				phandle = <0xe6>;
			};

			wcn_qos1: qos@1 {
				reg = <0x01>;
				arqos-gnss = [0c];
				awqos-gnss = [0c];
				arqos-gnss-i = [09];
				awqos-gnss-i = [09];
				arqos-gnss-d = [09];
				awqos-gnss-d = [09];
				arqos-dbuf = [09];
				awqos-dbuf = [09];
				phandle = <0xe7>;
			};

			wcn_qos_threshold: qos@2 {
				reg = <0x02>;
				arqos-threshold-wcn = [09];
				awqos-threshold-wcn = [09];
				phandle = <0xe8>;
			};
		};
	};

