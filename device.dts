		};

		cma_reserved: cma_share@f00000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf0000000 0x00 0x3000000>;
			reusable;
			linux,cma-default;
			phandle = <0x187>;
		};

		rebootescrow@0xfff70000 {
			no-map;
			reg = <0x00 0xfff70000 0x00 0x10000>;
