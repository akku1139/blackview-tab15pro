	soc: soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xe9>;

		ap_apb_regs: syscon@20000000 {
			compatible = "sprd,ums9230-glbregs", "syscon";
			#syscon-cells = <0x02>;
			reg = <0x00 0x20000000 0x00 0x3000>;
			phandle = <0x02>;
		};

		ap-apb {
			compatible = "simple-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			uart0: serial@0x200a0000 {
				compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
				reg = <0x00 0x200a0000 0x00 0x100>;
				interrupts = <0x00 0x02 0x04>;
				source-base = <0x20010024>;
				clock-frequency = <0x00>;
				uart-eb-syscon = <0x02 0x00 0x4000>;
				clocks = <0x03>;
				status = "okay";
				phandle = <0xea>;
			};

			uart1: serial@0x200b0000 {
				compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
				reg = <0x00 0x200b0000 0x00 0x100>;
				interrupts = <0x00 0x03 0x04>;
				source-base = <0x20010028>;
				clock-frequency = <0x00>;
				uart-eb-syscon = <0x02 0x00 0x8000>;
				clocks = <0x03>;
				status = "okay";
				phandle = <0xeb>;
			};

			uart2: serial@0x200c0000 {
				compatible = "sprd,ums9230-uart", "sprd,sc9836-uart";
				reg = <0x00 0x200c0000 0x00 0x100>;
				interrupts = <0x00 0x04 0x04>;
				source-base = <0x2001002c>;
				clock-frequency = <0x00>;
				uart-eb-syscon = <0x02 0x00 0x10000>;
				clocks = <0x03>;
				status = "okay";
				phandle = <0xec>;
			};

			i2c0: i2c@0x200d0000 {
				compatible = "sprd,qogirl6-i2c", "sprd,sc9860-i2c";
				reg = <0x00 0x200d0000 0x00 0x100>;
				interrupts = <0x00 0x0b 0x04>;
				clock-frequency = <0x61a80>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				syscon-names = "i2c_rst";
				syscons = <0x02 0x04 0x100>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x04 0x09 0x05 0x04 0x03>;
				phandle = <0xed>;

				sensor-sub@21 {
					phandle = <0x1c2>;
					power-domains = <0x17>;
					csi = <0x108>;
					sprd,phyid = <0x02>;
					power-down-gpios = <0x46 0x28 0x00>;
					reset-gpios = <0x46 0x29 0x00>;
					vddcammot-supply = <0x13c>;
					vddcamd-supply = <0x137>;
					vddcama-supply = <0x13a>;
					vddio-supply = <0x6d>;
					clocks = <0x10 0x04 0x0f 0x0b 0x06 0x04 0x06 0x10 0x06 0x05 0x03>;
					clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
					reg = <0x21>;
					compatible = "sprd,sensor-sub";
				};

				sensor-main@20 {
					phandle = <0x1c1>;
					power-domains = <0x17>;
					csi = <0x108>;
					sprd,phyid = <0x00>;
					power-down-gpios = <0x46 0x2e 0x00>;
					reset-gpios = <0x46 0x2c 0x00>;
					vddcammot-supply = <0x13c>;
					vddcamd-supply = <0x137>;
					vddcama-supply = <0x13a>;
					vddio-supply = <0x6d>;
					clocks = <0x10 0x02 0x0f 0x0d 0x06 0x04 0x06 0x10 0x06 0x05 0x03>;
					clock-names = "clk_src", "sensor_eb", "clk_96m", "clk_76m8", "clk_48m", "clk_26m";
					reg = <0x20>;
