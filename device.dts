			phandle = <0x9c>;
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0xb9>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xba>;
			phandle = <0x9e>;
		};

		CPU3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x300>;
			enable-method = "psci";
			cpu-idle-states = <0xb9>;
