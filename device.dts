	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x9a>;
				};

				core1 {
					cpu = <0x9c>;
				};

				core2 {
					cpu = <0x9e>;
				};

				core3 {
					cpu = <0xa0>;
				};

				core4 {
					cpu = <0xa2>;
				};

				core5 {
					cpu = <0xa4>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0xa6>;
				};

				core1 {
					cpu = <0xa8>;
				};
			};
		};

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0xb9>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			cpufreq-data-v1 = <0xba>;
			#cooling-cells = <0x02>;
			sugov_slack_timer;
			phandle = <0x9a>;
		};

		CPU1: cpu@100 {
			device_type = "cpu";
