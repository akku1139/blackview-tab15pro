	firmware {

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,vendor_boot,dtbo,l_modem,pm_sys,l_ldsp,l_gdsp,l_agdsp";
			};
		};
	};

	trusty {
		compatible = "sprd,trusty-smc-v1";

		irq {
			compatible = "sprd,trusty-irq-v1";
			interrupt-templates = <0x01 0x00 0x00 0x00 0x01 0x01 0x01 0x08 0x01 0x01 0x00 0x04>;
			interrupt-ranges = <0x00 0x0f 0x00 0x10 0x1f 0x01 0x20 0xdf 0x02>;
		};

		virtio {
			compatible = "sprd,trusty-virtio-v1";
		};

		log {
			compatible = "sprd,trusty-log-v1";
		};

		sprd-tshm {
			compatible = "sprd,tshm";
			memory-region = <0xcb>;
		};
	};

	rebootescrow@0 {
		compatible = "pmem-region";
		reg = <0x00 0xfff70000 0x00 0x10000>;
	};

	extcon_gpio: extcon-gpio {
		compatible = "linux,extcon-usb-gpio";
		vbus-gpio = <0x4a 0x00 0x00>;
		phandle = <0x192>;
	};

	sprd-sensorhub {
		compatible = "sprd,qogirl6-sensorhub", "sprd,sensor-hub";
	};

	sprd-map-user {
		compatible = "unisoc,map-user";
	};

	thm_zone: thermal-zones {
		phandle = <0x193>;

		chg-thmzone {
			phandle = <0x1c0>;
			thermal-sensors = <0x1a7>;
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
		};

		pa-thmzone {
			phandle = <0x1bf>;
			thermal-sensors = <0x1a6>;
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
		};

		board-thmzone {
			phandle = <0x1be>;
			thermal-sensors = <0x1a5>;
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
		};

		soc_thmzone: soc-thmzone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x1194>;
			thermal-sensors = <0xcc 0x00>;
			phandle = <0x194>;

			trips {

				soc_threshold: trip-point@0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x195>;
				};

				soc_target: trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xcd>;
				};

				soc_crit: soc_crit {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x196>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0xcd>;
					contribution = <0x400>;
					cooling-device = <0x9a 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0xcd>;
					contribution = <0x19a>;
					cooling-device = <0xa6 0xffffffff 0xffffffff>;
				};

				map2 {
					trip = <0xcd>;
					contribution = <0x800>;
					cooling-device = <0xce 0xffffffff 0xffffffff>;
				};

				map3 {
					trip = <0xcd>;
					contribution = <0x400>;
					cooling-device = <0xcf 0xffffffff 0xffffffff>;
				};

				map4 {
					trip = <0xcd>;
					contribution = <0x400>;
					cooling-device = <0xd0 0xffffffff 0xffffffff>;
				};
			};
		};

		cputop0_tzone0: cputop0-tzone0 {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0xd1 0x00>;
			phandle = <0x197>;
		};

		ank0_tzone1: ank0-tzone1 {
			polling-delay-passive = <0x00>;
			polling-delay = <0x00>;
			thermal-sensors = <0xd1 0x01>;
