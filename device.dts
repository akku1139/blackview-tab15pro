			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;

			vbc_v4: vbc@56480000 {
				compatible = "unisoc,qogirl6-vbc";
				#sound-dai-cells = <0x01>;
				reg = <0x00 0x56480000 0x00 0x1000>;
				sprd,syscon-agcp-ahb = <0x72>;
				sprd,vbc-phy-offset = <0x00>;
				pinctrl-names = "vbc_iis3_0", "vbc_iism0_0", "vbc_iis_to_pad", "vbc_iis_to_aon_usb", "vbc_iism0_1", "vbc_iism0_3", "vbc_iis0_3", "vbc_iis1_3", "vbc_iis2_3", "vbc_iis3_3", "ap_iis0_3", "vbc_iis3_5", "audcp_iis0_1";
				pinctrl-0 = <0x73>;
				pinctrl-1 = <0x74>;
				pinctrl-2 = <0x75>;
				pinctrl-3 = <0x76>;
				pinctrl-4 = <0x77>;
				pinctrl-5 = <0x78>;
				pinctrl-6 = <0x79>;
				pinctrl-7 = <0x7a>;
				pinctrl-8 = <0x7b>;
				pinctrl-9 = <0x7c>;
				pinctrl-10 = <0x7d>;
				pinctrl-11 = <0x7e>;
				pinctrl-12 = <0x7f>;
				pinctrl-13 = <0x80>;
				phandle = <0xc7>;
			};

			pdm_dmic: pdm-dmic@56401000 {
				compatible = "unisoc,pdm";
				status = "okay";
				reg = <0x00 0x56401000 0x00 0x1000>;
				#sound-dai-cells = <0x01>;
				sprd,syscon-agcp-ahb = <0x72>;
				phandle = <0x152>;
			};

			mcdt@56490000 {
				compatible = "unisoc,mcdt-r2p0";
				reg = <0x00 0x56490000 0x00 0x170>;
				interrupts = <0x00 0xb6 0x04>;
				sprd,ap-addr-offset = <0x00>;
				sprd,syscon-agcp-ahb = <0x72>;
			};

			agcp_dma: dma-controller@56580000 {
				compatible = "sprd,qogirl6-dma", "sprd,sc9860-dma";
				reg = <0x00 0x56580000 0x00 0x4000>;
				interrupts = <0x00 0xb4 0x04>;
				#dma-cells = <0x01>;
				#dma-channels = <0x20>;
				clock-names = "enable", "ashb_eb";
				clocks = <0x81 0x06 0x81 0x0d>;
				phandle = <0xb5>;
			};

			sprd_audio_codec_dig: audio-codec@56750000 {
				compatible = "unisoc,audio-codec-dig-agcp";
				reg = <0x00 0x56750000 0x00 0x1000>;
				sprd,syscon-agcp-ahb = <0x72>;
				phandle = <0x53>;
			};

			agdsp-access {
				compatible = "unisoc,agdsp-access";
				sprd,syscon-agcp-ahb = <0x09>;
				sprd,syscon-pmu-apb = <0x0d>;
				audcp_pmu_sleep_ctrl = <0x0d 0x850 0x08>;
				audcp_pmu_slp_status = <0x0d 0x860 0xf000>;
				audcp_pmu_pwr_status4 = <0x0d 0x544 0x1f00>;
				audcp_pmu_pwr_status3 = <0x0d 0x544 0x1f0000>;
				ap_access_ena = <0x09 0x14c 0x20>;
				sprd,ddr-addr-offset = <0x00>;
				sprd,auto_agcp_access = <0x00>;
			};
		};

		gic: interrupt-controller@10000000 {
			compatible = "arm,gic-v3";
			#interrupt-cells = <0x03>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			redistributor-stride = <0x00 0x20000>;
