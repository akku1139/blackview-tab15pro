				compatible = "sprd,qogirl6-adi", "sprd,sharkl5pro-adi";
				reg = <0x00 0x64200000 0x00 0x100000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				phandle = <0x126>;

				sc2730_pmic: pmic@0 {
					compatible = "sprd,sc2730";
					reg = <0x00>;
					spi-max-frequency = <0x18cba80>;
					interrupt-controller;
					#interrupt-cells = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					interrupts = <0x00 0xad 0x04>;
					phandle = <0x42>;

					pmic_wdt: watchdog@40 {
						compatible = "sprd,sc2730-wdt", "sprd,sc27xx-wdt";
						reg = <0x40>;
						phandle = <0x127>;
					};

					led-controller@180 {
						compatible = "sprd,sc2730-bltc";
						#address-cells = <0x01>;
						#size-cells = <0x00>;
						reg = <0x180>;

						led@0 {
							label = "red";
							reg = <0x00>;
						};

						led@1 {
							label = "green";
							reg = <0x01>;
						};

						led@2 {
							label = "blue";
							reg = <0x02>;
						};
					};

					rtc@200 {
						compatible = "sprd,sc2731-rtc", "sprd,sc2730-rtc";
						reg = <0x200>;
						interrupt-parent = <0x42>;
						interrupts = <0x01>;
					};

					pmic_eic: gpio@280 {
						compatible = "sprd,sc2731-eic", "sprd,sc2730-eic";
						reg = <0x280>;
						interrupt-parent = <0x42>;
						interrupts = <0x04>;
						gpio-controller;
						#gpio-cells = <0x02>;
						interrupt-controller;
						#interrupt-cells = <0x02>;
						phandle = <0x4a>;
					};

					efuse@300 {
						compatible = "sprd,sc2730-efuse";
						reg = <0x300>;
						#address-cells = <0x01>;
						#size-cells = <0x01>;
						hwlocks = <0x43 0x0c>;

						adc_bcal: calib@0 {
							reg = <0x24 0x02>;
							phandle = <0x48>;
						};

						adc_scal: calib@1 {
							reg = <0x26 0x02>;
							phandle = <0x49>;
						};

						pddelta_calib: calib@2 {
							reg = <0x02 0x02>;
							phandle = <0x4f>;
						};

						pdrc_calib: calib@6 {
							reg = <0x06 0x02>;
							phandle = <0x4e>;
						};

						pdref_calib: calib@1e {
							reg = <0x1e 0x02>;
							phandle = <0x50>;
						};

						fgu_calib: calib@3 {
							reg = <0x06 0x02>;
							phandle = <0x4b>;
						};

						typec_cc1_cal: calib@d1 {
							reg = <0x1a 0x02>;
							phandle = <0x44>;
						};

						typec_cc2_cal: calib@d2 {
							reg = <0x1a 0x02>;
							phandle = <0x45>;
						};

						aud_pabst_vcal: calib@20 {
							reg = <0x20 0x02>;
							phandle = <0x51>;
						};

						neg_cp_efuse: calib@22 {
							reg = <0x22 0x02>;
							phandle = <0x52>;
						};

						headset_adc_fir: calib@14 {
							reg = <0x28 0x02>;
							phandle = <0x47>;
						};

						headset_adc_sec: calib@16 {
							reg = <0x2c 0x02>;
							phandle = <0xc1>;
						};
					};

					pmic_typec: typec@380 {
						compatible = "sprd,sc2730-typec", "sprd,sc27xx-typec";
						interrupt-parent = <0x42>;
						interrupts = <0x08>;
						reg = <0x380>;
						sprd,mode = <0x02>;
						nvmem-cells = <0x44 0x45>;
						nvmem-cell-names = "typec_cc1_cal", "typec_cc2_cal";
						sprd,mcu-gpios = <0x46 0x52 0x01>;
						status = "okay";
						phandle = <0x4d>;
					};

					pmic_fchg: fchg@400 {
						phys = <0x6c>;
						sprd,support-sfcp;
						sprd,pd-fixed-max-microwatt = <0x112a880>;
						sprd,input-voltage-microvolt = <0x4c4b40>;
						compatible = "sprd,sc2730-fast-charger";
						reg = <0x400>;
						interrupt-parent = <0x42>;
						interrupts = <0x05 0x04>;
						nvmem-cell-names = "fchg_cur_calib";
						nvmem-cells = <0x47>;
						status = "okay";
						phandle = <0x128>;
					};

					pmic_adc: adc@504 {
						compatible = "sprd,sc2730-adc";
						reg = <0x504>;
						interrupt-parent = <0x42>;
						interrupts = <0x00>;
						#io-channel-cells = <0x01>;
						hwlocks = <0x43 0x04>;
						nvmem-cells = <0x48 0x49>;
						nvmem-cell-names = "big_scale_calib", "small_scale_calib";
						phandle = <0x4c>;
					};

					pmic_fgu: fgu@c00 {
						sprd,basp;
						sprd,capacity-charge-cycle;
						sprd,capacity-boot-calibration;
						sprd,capacity-sleep-calibration;
						sprd,relax-current-threshold = <0x1e>;
						sprd,relax-counter-threshold = <0x244>;
						phys = <0x6c>;
						fgu-capacity-track;
						sprd,comp-resistance-mohm = <0x14>;
						sprd,calib-resistance-micro-ohms = <0x12f2>;
						monitored-battery = <0x1a4>;
						compatible = "sprd,sc2730-fgu";
						reg = <0xc00>;
						bat-detect-gpio = <0x4a 0x03 0x00>;
						nvmem-cell-names = "fgu_calib";
						nvmem-cells = <0x4b>;
						io-channels = <0x4c 0x00 0x4c 0x0e>;
						io-channel-names = "bat-temp", "charge-vol";
						interrupt-parent = <0x42>;
						interrupts = <0x03>;
						phandle = <0x129>;
					};

					pmic_pd: pd@e00 {
						compatible = "sprd,sc27xx-pd", "sprd,sc2730-pd";
						reg = <0xe00 0x380>;
						interrupt-parent = <0x42>;
						interrupts = <0x09 0x04>;
						extcon = <0x4d>;
						nvmem-cells = <0x4e 0x4f 0x50>;
						nvmem-cell-names = "pdrc_calib", "pddelta_calib", "pdref_calib";
						status = "okay";
						phandle = <0x12a>;

						connector {
							phandle = <0x1cc>;
							op-sink-microwatt = <0x989680>;
							sink-pdos = <0x401912c 0xc0dc213c>;
							source-pdos = <0x4019028>;
							try-power-role = "sink";
							power-role = "dual";
							label = "USB-C";
							compatible = "usb-c-connector";
						};
					};

					sprd_audio_codec_ana: audio-codec@1000 {
						compatible = "unisoc,sc2730-audio-codec", "unisoc,sc2731-audio-codec";
						#sound-dai-cells = <0x01>;
						reg = <0x1000>;
						sprd,syscon-pmu-apb = <0x0d>;
						nvmem-cells = <0x51 0x52 0x4b>;
						nvmem-cell-names = "aud_pabst_vcal_efuse", "neg_cp_efuse", "fgu_4p2_efuse";
						status = "okay";
						hp-use-inter-pa = <0x01>;
						fixed-sample-rate = <0xbb80 0xbb80 0xbb80>;
						digital-codec = <0x53>;
						set-offset = <0x1000>;
						clr-offset = <0x2000>;
						lrdat-sel = <0x01>;
						phandle = <0xc8>;
					};

					syscon@1800 {
						compatible = "sprd,sc2731-syscon", "sprd,sc27xx-syscon";
						reg = <0x1800 0x1ba0 0x1b98>;
					};

					power-controller@1800 {
