	sipc: sipc-virt {
		compatible = "unisoc,sipc-virt-bus";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		phandle = <0x158>;

		core@4 {
			phandle = <0x1bb>;
			sprd,smem-info = <0x8749b000 0x11b000 0x32000>;
			mboxes = <0xb3 0x09 0x00>;
			label = "sipc-gnss";
			reg = <0x04>;
			#size-cells = <0x00>;
			#address-cells = <0x01>;
			compatible = "sprd,sipc";

			channel@4 {
				phandle = <0x1bc>;
				sprd,size-txbuf = <0xc800>;
				sprd,size-rxbuf = <0x19000>;
				sprd,ringnr = <0x01>;
				label = "sttygnss0";
				reg = <0x04>;
				compatible = "sprd,spipe";
			};
		};

		core@3 {
			phandle = <0x1ba>;
			sprd,smem-info = <0x87240000 0x240000 0x140000>;
			mboxes = <0xb3 0x08 0x00>;
			label = "sipc-wcn";
			reg = <0x03>;
			compatible = "sprd,sipc";

			wcn_fm {
				sprd,rx_bufid = <0x0d>;
				sprd,tx_bufid = <0x0e>;
				sprd,rx_channel = <0x04>;
				sprd,tx_channel = <0x04>;
				sprd,dst = <0x03>;
				sprd,name = "fm";
				compatible = "sprd,wcn_fm_internal_chip";
			};

			wcn_bt {
				sprd,rx_bufid = <0x0a>;
				sprd,tx_bufid = <0x0b>;
				sprd,channel = <0x04>;
				sprd,dst = <0x03>;
				sprd,name = "ttyBT";
				compatible = "sprd,wcn_internal_chip";
			};
		};

		sipc_lte: core@5 {
			compatible = "sprd,sipc";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x05>;
			label = "sipc-lte";
			mboxes = <0xb3 0x02 0x00>;
			sprd,smem-info = <0x8e000000 0x8e000000 0x900000>;
			phandle = <0x159>;

			imsbr_data: channel@2 {
				compatible = "sprd,spool";
				reg = <0x02>;
				label = "imsbr_data";
				sprd,tx-blksize = <0x5f4>;
				sprd,tx-blknum = <0x40>;
				sprd,rx-blksize = <0x5f4>;
				sprd,rx-blknum = <0x40>;
				phandle = <0x15a>;
			};

			imsbr_ctrl: channel@3 {
				compatible = "sprd,spool";
				reg = <0x03>;
				label = "imsbr_ctrl";
				sprd,tx-blksize = <0x80>;
